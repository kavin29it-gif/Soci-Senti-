# Environment Configuration for Social Intelligence & Risk Scoring Platform

# --- Supabase Configuration ---
# For local Supabase CLI (`supabase start`), default values are shown below.
# For Supabase Hosted Cloud, replace with your project URL and keys.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM0MTI4MDB9.CRXP1A_demo_anon_key
# IMPORTANT: Service Role key must NEVER be exposed to frontend or client-side code
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzQxMjgwMH0.demo_service_role_key
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# --- Ingestion & Queueing ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
REDIS_URL=redis://localhost:6379/0
STORE_RAW_HANDLES=false
AUTHOR_HASH_SALT=socisenti_super_secret_salt_2026_change_in_production

# --- ML & Model Serving ---
ML_SERVING_URL=http://localhost:8001
SENTENCE_TRANSFORMER_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIM=384
DRIFT_PSI_THRESHOLD=0.15

# --- Platform API Credentials (Optional: Mock replay runs without them) ---
# Reddit (PRAW)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=SociSentiBot/1.0

# YouTube Data API v3
YOUTUBE_API_KEY=

# Telegram (Telethon)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_BOT_TOKEN=

# --- Application Security & Roles ---
JWT_SECRET=super_secret_jwt_signing_key_for_development
APP_ENV=development
LOG_LEVEL=INFO
