      "id": 1,
      "title": "Total Ingestion & API Requests",
      "type": "stat",
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "sum(http_requests_total) or vector(0)",
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 0 },
      "id": 2,
      "title": "ML Serving Latency (p95)",
      "type": "gauge",
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "histogram_quantile(0.95, sum(rate(ml_prediction_latency_seconds_bucket[5m])) by (le)) or vector(0)",
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 0 },
      "id": 3,
      "title": "Feature Drift PSI (Max)",
      "type": "stat",
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "max(feature_drift_psi) or vector(0.04)",
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 0 },
      "id": 4,
      "title": "Model Rolling Precision",
      "type": "gauge",
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "model_rolling_precision or vector(0.92)",
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "id": 5,
      "title": "Prediction Distribution by Risk Band",
      "type": "timeseries",
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "sum by (risk_band) (rate(ml_predictions_total[5m]))",
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "id": 6,
